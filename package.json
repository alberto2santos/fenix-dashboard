{
  "name": "fenix-dashboard",
  "private": true,
  "version": "1.0.0",
  "author": {
    "name": "Alberto Luiz",
    "email": "alberto.dos.santos93@gmail.com",
    "url": "https://github.com/alberto2santos"
  },
  "description": "Dashboard de monitoramento de soldagem — Projeto Fênix II",
  "type": "module",
  "keywords": [
    "dashboard",
    "monitoramento",
    "soldagem",
    "projeto-fenix-ii"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Edge versions"
    ],
    "development": [
      "last 1 Chrome version"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/export.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true npm run build",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.90.24",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.24",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "mqtt": "^5.16.0",
    "papaparse": "^5.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.50.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
